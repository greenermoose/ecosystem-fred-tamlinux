+    void reportsRemovedFileComingBack() {
+        QTemporaryDir directory;
+        QVERIFY(directory.isValid());
+
+        const QString path = directory.filePath(QStringLiteral("rewritten.md"));
+        Backend backend;
+        QSignalSpy externalChangeSpy(&backend, &Backend::externalChangeDetected);
+        QSignalSpy restoredSpy(&backend, &Backend::externalFileRestored);
+
+        backend.saveAs(QUrl::fromLocalFile(path));
+        QVERIFY(QFileInfo::exists(path));
+
+        // unlink-then-create, the way many editors and agents rewrite a file
+        QVERIFY(QFile::remove(path));
+        QTRY_COMPARE(externalChangeSpy.count(), 1);
+        QVERIFY(externalChangeSpy.at(0).at(0).toBool());
+
+        QFile recreated(path);
+        QVERIFY(recreated.open(QIODevice::WriteOnly | QIODevice::Truncate));
+        QCOMPARE(recreated.write("rewritten elsewhere"), qint64(19));
+        recreated.close();
+        QTRY_COMPARE(externalChangeSpy.count(), 2);
+        QVERIFY(!externalChangeSpy.at(1).at(0).toBool());
+        QCOMPARE(restoredSpy.count(), 0);
+
+        // Reload must work now that the file is back
+        backend.reloadFromDisk();
+        QVERIFY(!backend.modified());
+        QVERIFY(backend.status().startsWith(QStringLiteral("Opened")));
+
+        // A file that comes back byte-identical is restored, not changed
+        QVERIFY(QFile::remove(path));
+        QTRY_COMPARE(externalChangeSpy.count(), 3);
+        QFile identical(path);
+        QVERIFY(identical.open(QIODevice::WriteOnly | QIODevice::Truncate));
+        QCOMPARE(identical.write("rewritten elsewhere"), qint64(19));
+        identical.close();
+        QTRY_COMPARE(restoredSpy.count(), 1);
+        QCOMPARE(externalChangeSpy.count(), 3);
+    }
+
+    void reloadOfMissingFileKeepsText() {
+        QTemporaryDir directory;
+        QVERIFY(directory.isValid());
+
+        const QString path = directory.filePath(QStringLiteral("gone.md"));
+        Backend backend;
+        QSignalSpy externalChangeSpy(&backend, &Backend::externalChangeDetected);
+
+        backend.saveAs(QUrl::fromLocalFile(path));
+        QVERIFY(QFile::remove(path));
+        QTRY_COMPARE(externalChangeSpy.count(), 1);
+
+        backend.reloadFromDisk();
+        QVERIFY(backend.modified());
+        QVERIFY(backend.status().contains(QStringLiteral("no longer on disk")));
+    }
