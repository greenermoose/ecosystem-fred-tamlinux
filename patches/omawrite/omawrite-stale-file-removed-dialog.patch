                 emit externalChangeDetected(deleted, m_modified);
             });
+    connect(&m_fileWatcher, &QFileSystemWatcher::directoryChanged, this,
+            [this](const QString &directory) {
+                // Only armed after the file was reported removed. Tools that
+                // rewrite by unlink-then-create bring the file back moments
+                // later; tell the UI so "File removed" does not go stale.
+                const QString path = m_fileUrl.toLocalFile();
+                if (!m_fileUrl.isLocalFile()
+                        || QFileInfo(path).absolutePath() != directory
+                        || !QFileInfo::exists(path))
+                    return;
+
+                watchCurrentFile();
+                QFile file(path);
+                const bool unchanged = m_hasKnownFileContents
+                        && file.open(QIODevice::ReadOnly)
+                        && file.readAll() == m_lastKnownFileContents;
+                if (unchanged)
+                    emit externalFileRestored();
+                else
+                    emit externalChangeDetected(false, m_modified);
+            });
 
