@@ -258,8 +281,18 @@ void Backend::discardRecovery() {
 }
 
 void Backend::reloadFromDisk() {
-    if (m_fileUrl.isLocalFile())
-        open(m_fileUrl);
+    if (!m_fileUrl.isLocalFile())
+        return;
+
+    // The dialog's "removed" verdict is a snapshot from the watcher event and
+    // may be stale by the time the user answers. Check again now.
+    if (!QFileInfo::exists(m_fileUrl.toLocalFile())) {
+        keepExternalVersion();
+        setStatus(QStringLiteral("%1 is no longer on disk; kept your version")
+                      .arg(fileName()));
+        return;
+    }
+    open(m_fileUrl);
 }
 
 void Backend::keepExternalVersion() {
@@ -566,13 +599,24 @@ void Backend::clearRecovery() {
 }
 
 void Backend::watchCurrentFile() {
-    const QStringList watched = m_fileWatcher.files();
+    const QStringList watched = m_fileWatcher.files() + m_fileWatcher.directories();
     if (!watched.isEmpty())
         m_fileWatcher.removePaths(watched);
     if (m_fileUrl.isLocalFile() && QFileInfo::exists(m_fileUrl.toLocalFile()))
         m_fileWatcher.addPath(m_fileUrl.toLocalFile());
 }
 
+void Backend::watchCurrentDirectory() {
+    const QStringList watched = m_fileWatcher.directories();
+    if (!watched.isEmpty())
+        m_fileWatcher.removePaths(watched);
+    if (!m_fileUrl.isLocalFile())
+        return;
+    const QString directory = QFileInfo(m_fileUrl.toLocalFile()).absolutePath();
+    if (QFileInfo::exists(directory))
+        m_fileWatcher.addPath(directory);
+}
