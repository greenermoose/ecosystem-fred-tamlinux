#!/bin/bash
# Reports the status of the local omawrite fixes after any omawrite install/upgrade.
# Driven by /etc/pacman.d/hooks/50-omawrite-local-patch.hook.
#
# The patches add a native window close button, make CLI file arguments open reliably,
# and keep the "File removed" dialog honest (Reload works; a restored file is noticed).
# See docs/agent-runbooks/local-package-patching.md.
#
# Three outcomes:
#   upstream fix present -> say so, tell the user to retire the local patch
#   patched build intact -> stay silent
#   anything else        -> the patch was replaced; say so

set -uo pipefail

state_dir=/var/lib/omawrite-local-patch
stamp="$state_dir/patched-version"
status="$state_dir/status"

installed=$(pacman -Q omawrite 2>/dev/null | awk '{print $2}')
[[ -n $installed ]] || exit 0

note() {
  mkdir -p "$state_dir"
  printf '%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "$installed" "$1" >"$status"
}

fixed_upstream() {
  local v=$1
  (($(vercmp "$v" "0.5.1") >= 0))
}

if fixed_upstream "$installed"; then
  note "upstream-newer"
  cat <<END
>> omawrite $installed is newer than the locally patched 0.5.0-1.5.
>> The local patches are GONE until you act. \`omawrite-review\` (how agents show
>> Fred their plans) depends on the CLI-file patch, so check now, not later:
>>
>>   1. Does \`omawrite /abs/path/file.md\` open that file (not Untitled.md)?
>>   2. Is there an in-window close button?
>>   3. rm+recreate an open file: does Reload in "File removed" work?
>>   4. Does launching log "Binding loop detected" for the shortcuts dialog?
>>      (journalctl --user -- stderr is silent when it is not a TTY)
>>
>> If anything is missing, REBASE the patches onto $installed — see
>> "Rebasing onto a new upstream release" in
>> ~/docs/agent-runbooks/local-package-patching.md (makepkg -Cf runs the tests).
>>
>> If all four are fixed upstream, retire the local patch:
>>
>>     repo-remove /var/cache/local-patches/local-patches.db.tar.zst omawrite omawrite-debug
>>     rm -rf ~/pkgs/omawrite /var/cache/local-patches/omawrite-*.pkg.tar.zst
>>     pkexec rm -f /etc/pacman.d/hooks/50-omawrite-local-patch.hook \\
>>                  /usr/local/bin/omawrite-local-patch-check
>>     pkexec rm -rf /var/lib/omawrite-local-patch

END
  exit 0
fi

expected=$(cat "$stamp" 2>/dev/null || true)

if [[ -n $expected && $installed == "$expected" ]]; then
  note "patched"
  exit 0
fi

note "PATCH-LOST"
cat <<END
!! omawrite $installed replaced the locally patched ${expected:-<none recorded>}.
!! The local Omawrite fixes are MISSING. Rebuild the patched package:
!!
!!     cd ~/pkgs/omawrite && makepkg -Cf
!!     repo-add /var/cache/local-patches/local-patches.db.tar.zst \\
!!              /var/cache/local-patches/omawrite{,-debug}-*.pkg.tar.zst
!!     pkexec pacman -Syu
!!
!! Runbook: ~/docs/agent-runbooks/local-package-patching.md

END
exit 0
