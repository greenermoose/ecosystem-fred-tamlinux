diff --git a/src/WindowCloseButton.qml b/src/WindowCloseButton.qml
new file mode 100644
index 0000000000000000000000000000000000000000..f85c90b97a2423c7bd74da1cc1973c37aa52aca6
--- /dev/null
+++ b/src/WindowCloseButton.qml
@@ -0,0 +1,100 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Window
+
+Item {
+    id: control
+
+    signal clicked()
+
+    property bool darkMode: false
+    property color pageColor: "#1a1a1a"
+    property color iconColor: "#666666"
+    property color activeIconColor: "#ffffff"
+    property real textScale: 1.0
+
+    readonly property real buttonSize: Math.max(20, Math.round(28 * textScale))
+    readonly property real canvasSize: Math.max(10, Math.round(14 * textScale))
+
+    width: buttonSize
+    height: buttonSize
+
+    ToolTip.visible: mouseArea.containsMouse && !mouseArea.pressed
+    ToolTip.text: "Close"
+    ToolTip.delay: 400
+
+    Rectangle {
+        id: baseBg
+        anchors.fill: parent
+        radius: width / 2
+        color: control.pageColor
+    }
+
+    Rectangle {
+        id: bg
+        anchors.fill: parent
+        radius: width / 2
+        color: {
+            if (mouseArea.pressed)
+                return control.darkMode ? "rgba(255, 255, 255, 0.22)" : "rgba(0, 0, 0, 0.16)";
+            if (mouseArea.containsMouse)
+                return control.darkMode ? "rgba(255, 255, 255, 0.14)" : "rgba(0, 0, 0, 0.09)";
+            return control.darkMode ? "rgba(255, 255, 255, 0.06)" : "rgba(0, 0, 0, 0.04)";
+        }
+        border.color: control.darkMode ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.06)"
+        border.width: 1
+        Behavior on color { ColorAnimation { duration: 100 } }
+    }
+
+    Canvas {
+        id: iconCanvas
+        anchors.centerIn: parent
+
+        readonly property real dpr: Screen.devicePixelRatio
+        width: control.canvasSize * dpr
+        height: control.canvasSize * dpr
+        scale: 1 / dpr
+        onDprChanged: requestPaint()
+
+        onPaint: {
+            var context = getContext("2d");
+            context.setTransform(dpr, 0, 0, dpr, 0, 0);
+            context.clearRect(0, 0, control.canvasSize, control.canvasSize);
+            context.strokeStyle = mouseArea.containsMouse
+                ? control.activeIconColor
+                : control.iconColor;
+            context.lineWidth = Math.max(1.5, 1.5 * control.textScale);
+            context.lineCap = "round";
+            context.beginPath();
+
+            var m = control.canvasSize * 0.24;
+            var end = control.canvasSize - m;
+            context.moveTo(m, m);
+            context.lineTo(end, end);
+            context.moveTo(end, m);
+            context.lineTo(m, end);
+            context.stroke();
+        }
+
+        Connections {
+            target: control
+            function onIconColorChanged() { iconCanvas.requestPaint(); }
+            function onActiveIconColorChanged() { iconCanvas.requestPaint(); }
+            function onTextScaleChanged() { iconCanvas.requestPaint(); }
+            function onDarkModeChanged() { iconCanvas.requestPaint(); }
+        }
+
+        Connections {
+            target: mouseArea
+            function onContainsMouseChanged() { iconCanvas.requestPaint(); }
+        }
+    }
+
+    MouseArea {
+        id: mouseArea
+        anchors.fill: parent
+        hoverEnabled: true
+        cursorShape: Qt.PointingHandCursor
+        onClicked: control.clicked()
+    }
+}
