+    void closesFromWindowCloseButton() {
+        const QString mainQmlPath = QFINDTESTDATA("../src/Main.qml");
+        QVERIFY(!mainQmlPath.isEmpty());
+
+        Backend backend;
+        QQmlEngine engine;
+        engine.rootContext()->setContextProperty(QStringLiteral("backend"), &backend);
+        QQmlComponent component(&engine, QUrl::fromLocalFile(mainQmlPath));
+        QVERIFY2(component.isReady(), qPrintable(component.errorString()));
+        QScopedPointer<QObject> window(component.create());
+        QVERIFY2(window, qPrintable(component.errorString()));
+
+        QObject *closeButton = window->findChild<QObject *>(QStringLiteral("windowCloseButton"));
+        QVERIFY(closeButton);
+
+        QVERIFY(QMetaObject::invokeMethod(closeButton, "clicked"));
+        QCOMPARE(window->property("visible").toBool(), false);
+    }
