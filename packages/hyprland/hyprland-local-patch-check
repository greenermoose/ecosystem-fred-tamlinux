#!/bin/bash
# Reports the status of the three local hyprland patches after any hyprland
# install/upgrade. Driven by /etc/pacman.d/hooks/50-hyprland-local-patch.hook.
#
# Patch 1 (hyprland-dpms-off-on-connect.patch, since 0.56.2-3.1): makes
# CMonitor::onConnect() bring a monitor up disabled when DPMS is globally off.
# Without it, a panel that drops HPD after losing signal and reconnects (input
# auto-scan, ~6 s after DPMS-off on this machine) is re-created lit: the blank
# lasts ~8 s, and the bus-powered MSI on DP-2 gets a cold link training that
# intermittently comes up jittering (Fault C).
# Upstream: hyprwm/Hyprland#16290 (filed and auto-closed 2026-09-17, unvouched; not to be
# re-filed — hyprwm AI policy). Public copy: greenermoose/Hyprland patch/monitor-inherit-dpms-on-connect.
#
# Patch 2 (hyprland-idle-inhibit-unchanged-noop.patch, since 0.56.2-3.2): makes
# CIdleNotifyProtocol::setInhibit() a no-op when the inhibit state is
# unchanged. Without it every window focus change resets all ext-idle-notify
# timers as if the user had touched the mouse, so hypridle never reaches its
# 30-minute suspend rule whenever anything focuses a window while idle
# (2026-09-17 incident: 85 blank/resume cycles overnight, no suspend).
# Upstream: unfixed on main as of 2026-09-17; not filed (hyprwm AI policy). Public copy:
# greenermoose/Hyprland patch/idle-notify-inhibit-unchanged-noop; registry ecosystem-fred-tamlinux.
#
# Patch 3 (hyprland-dpms-state-per-monitor.patch, since 0.56.2-3.3): derives
# g_pCompositor->m_dpmsStateOn from the monitors instead of letting the dpms
# dispatcher assign it from the last monitor touched. Without it a per-monitor
# `dpms off` (fred.workspaces' unused-monitor blank) marks the whole compositor
# DPMS-off and the next mouse move on any lit monitor re-lights the blanked
# one (2026-09-17 23:02). It also remembers per-output DPMS-off across an HPD
# drop/reconnect so the HP does not come back lit 1 s after each blank.
# Upstream: same code on main as of 2026-09-17; not filed (hyprwm AI policy). Public copy:
# greenermoose/Hyprland patch/dpms-state-per-monitor; registry ecosystem-fred-tamlinux.
#
# See docs/agent-runbooks/local-package-patching.md,
# docs/agent-runbooks/display-output-instability.md and
# docs/incidents/2026-09-17-idle-loop-no-suspend.md.
#
# Three outcomes:
#   upstream fix present -> say so, tell the user to retire the local patch
#   patched build intact -> stay silent
#   anything else        -> the patch was replaced; say so loudly

set -uo pipefail

state_dir=/var/lib/hyprland-local-patch
stamp="$state_dir/patched-version"
status="$state_dir/status"

# First Arch release known to contain ALL THREE upstream fixes. Empty until
# they are merged and released; fill it in then, e.g. "0.57.0-1". If only some
# land first, leave this empty and drop those patches from the PKGBUILD
# instead (the rest still need the local build).
fixed_upstream_version=""

installed=$(pacman -Q hyprland 2>/dev/null | awk '{print $2}')
[[ -n $installed ]] || exit 0

note() {
  mkdir -p "$state_dir"
  printf '%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "$installed" "$1" >"$status"
}

fixed_upstream() {
  [[ -n $fixed_upstream_version ]] || return 1
  (($(vercmp "$1" "$fixed_upstream_version") >= 0))
}

if fixed_upstream "$installed"; then
  note "upstream-fixed"
  cat <<EOM

>> hyprland $installed carries all three upstream fixes (DPMS-on-connect, the
>> idle-inhibit unchanged guard, per-monitor DPMS state). The local patches have done their job and
>> should now be retired:
>>
>>     repo-remove /var/cache/local-patches/local-patches.db.tar.zst hyprland hyprland-debug
>>     rm -rf ~/pkgs/hyprland /var/cache/local-patches/hyprland-*.pkg.tar.zst
>>     # then drop [local-patches] from /etc/pacman.conf if nothing else uses it
>>     pkexec rm -f /etc/pacman.d/hooks/50-hyprland-local-patch.hook \\
>>                  /usr/local/bin/hyprland-local-patch-check
>>     pkexec rm -rf /var/lib/hyprland-local-patch

EOM
  exit 0
fi

expected=$(cat "$stamp" 2>/dev/null || true)

if [[ -n $expected && $installed == "$expected" ]]; then
  note "patched"
  exit 0
fi

note "PATCH-LOST"
cat <<EOM

!! hyprland $installed replaced the locally patched ${expected:-<none recorded>}.
!! Unless this release contains all three upstream fixes:
!!   - DPMS blanking is BACK to an ~8 s blink: the panels reconnect after
!!     losing signal and come up lit, and every blank costs the MSI (DP-2) a
!!     cold link training that can jitter (Fault C);
!!   - any focus change while idle resets hypridle's timers again, so the
!!     machine may never reach its suspend rule (2026-09-17 incident);
!!   - a monitor blanked on its own (fred.workspaces unused-monitor blank)
!!     wakes again on the next mouse move on any other monitor.
!! Check first (each must be 1 in the patched binary):
!!
!!     strings /usr/bin/Hyprland | grep -c 'connected while DPMS is off'      # patch 1
!!     strings /usr/bin/Hyprland | grep -c 'inhibit state unchanged'          # patch 2
!!     strings /usr/bin/Hyprland | grep -c 'compositor-wide'                  # patch 3
!!     https://github.com/hyprwm/Hyprland/pull/16290
!!
!! If all three fixes are in: set fixed_upstream_version in this script and retire
!! the patches (see above). If not, rebuild the patched package:
!!
!!     cd ~/pkgs/hyprland && git fetch && git checkout <arch tag>   # refresh Arch's PKGBUILD
!!     # re-apply the pkgrel .N bump + patches (see the runbook), then:
!!     makepkg -Cf --noconfirm
!!     repo-add /var/cache/local-patches/local-patches.db.tar.zst \\
!!              /var/cache/local-patches/hyprland{,-debug}-*.pkg.tar.zst
!!     pkexec pacman -Syu
!!     # then log out and back in: the running compositor keeps the old binary
!!
!! Runbook: ~/docs/agent-runbooks/local-package-patching.md

EOM
exit 0
